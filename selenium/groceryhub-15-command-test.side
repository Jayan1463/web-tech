{
  "id": "8c80937d-78c1-4ec9-918b-a66c09515cd0",
  "version": "2.0",
  "name": "GroceryHub 12 Unique Command Selenium Test",
  "url": "http://127.0.0.1:8080/Grocery_shop",
  "tests": [{
    "id": "9f99fa67-844d-4982-98d5-d4a8f7398f64",
    "name": "GroceryHub 12 Unique Commands",
    "commands": [{
      "id": "cmd-01",
      "comment": "1. Open the home page.",
      "command": "open",
      "target": "/Grocery_shop/",
      "targets": [],
      "value": ""
    }, {
      "id": "cmd-02",
      "comment": "2. Resize browser.",
      "command": "setWindowSize",
      "target": "1536x864",
      "targets": [],
      "value": ""
    }, {
      "id": "cmd-03",
      "comment": "3. Check home title.",
      "command": "assertTitle",
      "target": "GroceryHub - Fresh Groceries",
      "targets": [],
      "value": ""
    }, {
      "id": "cmd-04",
      "comment": "4. Check hero heading text.",
      "command": "assertText",
      "target": "css=.hero h1",
      "targets": [["css=.hero h1", "css:finder"]],
      "value": "Fresh groceries,*"
    }, {
      "id": "cmd-05",
      "comment": "5. Go to Products.",
      "command": "click",
      "target": "linkText=Shop Now",
      "targets": [["linkText=Shop Now", "linkText"]],
      "value": ""
    }, {
      "id": "cmd-06",
      "comment": "6. Wait for Products page heading.",
      "command": "waitForElementVisible",
      "target": "css=.products-header h1",
      "targets": [["css=.products-header h1", "css:finder"]],
      "value": "10000"
    }, {
      "id": "cmd-07",
      "comment": "7. Confirm search form exists.",
      "command": "assertElementPresent",
      "target": "css=.search-form",
      "targets": [["css=.search-form", "css:finder"]],
      "value": ""
    }, {
      "id": "cmd-08",
      "comment": "8. Store page title.",
      "command": "storeTitle",
      "target": "",
      "targets": [],
      "value": "pageTitle"
    }, {
      "id": "cmd-09",
      "comment": "9. Print stored title.",
      "command": "echo",
      "target": "${pageTitle}",
      "targets": [],
      "value": ""
    }, {
      "id": "cmd-10",
      "comment": "10. Store current URL.",
      "command": "storeLocation",
      "target": "",
      "targets": [],
      "value": "currentUrl"
    }, {
      "id": "cmd-11",
      "comment": "11. Confirm products URL.",
      "command": "assertLocation",
      "target": "*/products",
      "targets": [],
      "value": ""
    }, {
      "id": "cmd-12",
      "comment": "12. Refresh current page.",
      "command": "refresh",
      "target": "",
      "targets": [],
      "value": ""
    }]
  }],
  "suites": [{
    "id": "fc65955b-90dd-4d6a-9f66-81d23f6b628c",
    "name": "GroceryHub Suite",
    "persistSession": false,
    "parallel": false,
    "timeout": 300,
    "tests": ["9f99fa67-844d-4982-98d5-d4a8f7398f64"]
  }],
  "urls": ["http://127.0.0.1:8080/Grocery_shop"],
  "plugins": []
}
